---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Frame from '../../components/Frame.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}
const post = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
const date = pubDate.toISOString().slice(0, 10);
const updated = updatedDate?.toISOString().slice(0, 10);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Layout title={title} description={description}>
  <article>
    <Frame title="INVESTIGACIÓN / ARTÍCULO">
      <h1 class="post-title">{title}</h1>
      <p class="hx-lead">{description}</p>
      <p class="post-meta">FECHA: <time datetime={date}>{date}</time>
        {updated && <> // ACTUALIZADO: <time datetime={updated}>{updated}</time></>}
        {tags.length > 0 && <> // TEMAS: {tags.map((tag) => <a href={`/blog/tag/${tag}/`}>[{tag}] </a>)}</>}
      </p>
      {heroImage && <Image class="post-hero" src={heroImage} alt="" width={1280} loading="eager" />}
      {toc.length > 1 && <nav class="hx-toc" aria-label="Índice del artículo">
        <strong>IR A UNA SECCIÓN</strong>
        <ol>{toc.map((h) => <li class:list={['hx-toc-item', {'hx-toc-sub': h.depth === 3}]}>
          <a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>}
      <div class="prose hx-prose"><Content /></div>
    </Frame>
    <nav class="post-nav"><a class="menu-item" href="/blog/"><span class="mi-marker">▪ ‹</span><span class="mi-title">VOLVER AL BLOG</span></a></nav>
  </article>
</Layout>
