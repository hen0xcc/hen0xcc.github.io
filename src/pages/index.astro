---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';

const blog = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const labs = (await getCollection('labs', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<Layout title="Research" description="Investigación ofensiva y validación de defensas: artículos y laboratorios reproducibles.">
  <Frame title="HEN0XCC / RESEARCH TERMINAL">
    <div class="hx-intro">
      <p class="hx-prompt">hen0xcc@research:~$ ./learn --by-doing</p>
      <h1>Break it. Detect it. Defend it.</h1>
      <p>Investigación ofensiva, ingeniería de detección y validación de controles de seguridad. Explicación, pruebas y evidencia en un mismo lugar.</p>
      <div class="hx-actions">
        <a href="/blog/">EXPLORAR BLOG →</a>
        <a href="/labs/">VER LABORATORIOS →</a>
      </div>
    </div>
  </Frame>
  <div class="hx-two-col">
    <Frame title="BLOG / PUBLICACIONES">
      <p class="hx-kicker">Investigación · Análisis · Recomendaciones</p>
      {blog.length ? <div class="hx-stack">{blog.map((post) => (
        <a class="hx-entry" href={`/blog/${post.id}/`}>
          <strong>{post.data.title}</strong>
          <span>{post.data.description}</span>
        </a>
      ))}</div> : <p>Próximamente: primeras investigaciones.</p>}
      <p class="hx-more"><a href="/blog/">VER TODAS LAS PUBLICACIONES →</a></p>
    </Frame>
    <Frame title="LABS / EXPERIMENTOS">
      <p class="hx-kicker">Pruebas · Comandos · Resultados</p>
      {labs.length ? <div class="hx-stack">{labs.map((lab) => (
        <a class="hx-entry" href={`/labs/${lab.id}/`}>
          <strong>{lab.data.title}</strong>
          <span>{lab.data.description}</span>
        </a>
      ))}</div> : <p>Próximamente: primeros laboratorios reproducibles.</p>}
      <p class="hx-more"><a href="/labs/">VER TODOS LOS LABS →</a></p>
    </Frame>
  </div>
  <Frame title="QUIÉN PUBLICA">
    <p>Sobre el proyecto y su enfoque: <a href="/about/">WHOAMI →</a></p>
  </Frame>
</Layout>
