---
import '../styles/terminal.css';
import '../styles/hen0xcc-sections.css';
import '../styles/modern.css';
import TerminalHeader from '../components/TerminalHeader.astro';
import TerminalFooter from '../components/TerminalFooter.astro';
import HackGate from '../components/HackGate.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  PRIVATE_MODE,
  SITE_VENDOR,
  SITE_SYSTEM,
  SITE_MODEL,
} from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} // ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="es" data-theme="amber">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/WebPlus_IBM_VGA_8x16.woff"
      as="font"
      type="font/woff"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <title>{pageTitle}</title>
    <!-- Apply the saved theme before first paint so it does not flash. -->
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved === 'green' || saved === 'amber') {
        document.documentElement.dataset.theme = saved;
      }
    </script>
  </head>
  <body>
    <!-- Power-on screen: once per session, dismissed by any click or key. -->
    <div class="crt-boot" id="crt-boot" aria-hidden="true">
      <div class="crt-boot__screen">
        <pre class="crt-boot__lines">{[
          `${SITE_VENDOR} (TM) ${SITE_SYSTEM} PROTOCOL`,
          `INITIALIZING ${SITE_MODEL}...`,
          '',
          '> SET TERMINAL/INQUIRE',
          SITE_MODEL,
          '> SET FILE/PROTECTION=OWNER:RWED ACCOUNTS.F',
          '> SET HALT RESTART/MAINT',
          '',
          `INITIALIZING ${SITE_VENDOR}(TM) BOOT AGENT v2.3.0`,
          'RETROS BIOS  RBIOS-4.02.08.00 52EE5.E7.E8',
          `COPYRIGHT 1984-1991 ${SITE_VENDOR}`,
          'UPPERMEM: 64 KB   ROOT: 05EAC8FF',
          'EXECUTING THREAD...',
          'LOAD ' + SITE_TITLE + ' // READY',
        ].map((line, i) => (
          <span class="boot-line" style={`--i:${i}`}>{line + '\n'}</span>
        ))}</pre>
        <div class="crt-boot__skip">[ PRESS ANY KEY ]</div>
      </div>
    </div>
    <script is:inline>
      // Skip the screen entirely rather than flashing it and hiding it.
      (function () {
        var boot = document.getElementById('crt-boot');
        if (!boot) return;
        var mq = window.matchMedia;
        var reduce = mq && mq('(prefers-reduced-motion: reduce)').matches;
        var narrow = mq && mq('(max-width: 640px)').matches;
        if (reduce || narrow || sessionStorage.getItem('booted')) {
          boot.classList.add('crt-boot--off');
        }
      })();
    </script>

    {PRIVATE_MODE && <HackGate />}

    <div class="crt">
      <div class="container">
        <TerminalHeader />
        <main>
          <slot />
        </main>
        <TerminalFooter />
      </div>
    </div>

    <script>
      import { sfx, bindSfx } from '../scripts/sfx';

      // Links, buttons and list rows all sound like menu items.
      bindSfx(document, '.menu-item, .h-nav a, .h-nav button, .logo, [data-sfx]');

      // Two sound buttons exist (header and footer) and only one is ever
      // visible, but both have to stay in sync.
      const soundBtns = document.querySelectorAll<HTMLButtonElement>(
        '[data-action="sound"]',
      );

      function drawSound() {
        soundBtns.forEach((btn) => {
          btn.setAttribute('aria-pressed', String(sfx.enabled));
          const label = btn.querySelector<HTMLElement>('[data-sound-label]');
          if (label) label.textContent = sfx.enabled ? '♪ SND' : '♪ SND OFF';
        });
      }
      drawSound();

      soundBtns.forEach((btn) =>
        btn.addEventListener('click', () => {
          sfx.enabled = !sfx.enabled;
          drawSound();
          if (sfx.enabled) sfx.select(); // Confirm switching on, audibly.
        }),
      );

      (function () {
        const boot = document.getElementById('crt-boot');
        if (!boot || boot.classList.contains('crt-boot--off')) return;
        sessionStorage.setItem('booted', '1');
        let done = false;
        const dismiss = () => {
          if (done) return;
          done = true;
          boot.classList.add('crt-boot--done');
          setTimeout(() => boot.remove(), 400);
        };
        boot.addEventListener('click', dismiss);
        // Catch the key before the nav hotkeys so it only dismisses boot.
        window.addEventListener(
          'keydown',
          (e) => {
            e.stopImmediatePropagation();
            dismiss();
          },
          { once: true, capture: false },
        );
        setTimeout(dismiss, 2600);
      })();

      function toggleTheme() {
        const el = document.documentElement;
        const next = el.dataset.theme === 'green' ? 'amber' : 'green';
        el.dataset.theme = next;
        localStorage.setItem('theme', next);
        sfx.power(); // The screen "relights", so the phosphor hums.
      }

      document
        .querySelectorAll('[data-action="theme"]')
        .forEach((btn) => btn.addEventListener('click', toggleTheme));

      window.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target as HTMLElement;
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        switch (e.key.toLowerCase()) {
          // Each hotkey is listed twice: the Latin key and the same
          // physical key under a Russian keyboard layout.
          case 'h':
          case 'р':
            location.href = '/';
            break;
          case 'a':
          case 'ф':
            location.href = '/blog/';
            break;
          case 't':
          case 'е':
            toggleTheme();
            break;
        }
      });
    </script>
  <!-- Estadisticas opcionales: no cargar Google Analytics sin consentimiento -->
    <section id="analytics-consent" class="analytics-consent" aria-label="Preferencias de estadísticas" hidden>
      <p class="analytics-consent__title">ESTADÍSTICAS DEL BLOG</p>
      <p>
        ¿Nos ayudas a conocer qué artículos se consultan? Si aceptas,
        usaremos Google Analytics para medir visitas e interacción.
        Puedes rechazarlo y seguir leyendo sin problema.
        <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">Cómo utiliza Google los datos</a>.
      </p>
      <div class="analytics-consent__actions">
        <button type="button" id="analytics-reject">Rechazar</button>
        <button type="button" id="analytics-accept">Aceptar estadísticas</button>
      </div>
    </section>
    <button type="button" id="analytics-settings" class="analytics-settings" hidden>
      Preferencias de estadísticas
    </button>

    <style is:global>
      .analytics-consent[hidden], .analytics-settings[hidden] { display: none !important; }
      .analytics-consent {
        position: fixed; z-index: 9999; bottom: 16px; left: 16px;
        width: min(560px, calc(100vw - 32px)); max-height: calc(100vh - 32px);
        overflow: auto; box-sizing: border-box; padding: 18px;
        border: 1px solid #b89252; background: #171b1a;
        color: #f5e6c3; box-shadow: 0 8px 30px #0009;
        font: 14px/1.55 system-ui, sans-serif;
      }
      .analytics-consent__title { font-weight: 700; letter-spacing: .06em; margin: 0 0 6px; }
      .analytics-consent p { margin: 0 0 12px; }
      .analytics-consent a { color: #ffcf76; text-decoration: underline; }
      .analytics-consent__actions { display: flex; gap: 10px; flex-wrap: wrap; }
      .analytics-consent button, .analytics-settings {
        cursor: pointer; border: 1px solid #c4a063; border-radius: 3px;
        padding: 8px 12px; color: #f5e6c3; background: #30332b;
        font: inherit;
      }
      #analytics-accept { background: #705527; }
      .analytics-consent button:focus-visible, .analytics-settings:focus-visible {
        outline: 2px solid #ffcf76; outline-offset: 2px;
      }
      .analytics-settings {
        position: fixed; z-index: 9998; bottom: 10px; right: 10px;
        font: 12px/1.3 system-ui, sans-serif;
      }
      @media (max-width: 640px) {
        .analytics-consent { left: 8px; bottom: 8px; width: calc(100vw - 16px); }
      }
    </style>
    <script is:inline>
      (function () {
        var KEY = 'hen0xcc_analytics_consent_v1';
        var GA_ID = 'G-BK8WL5N1X9';
        var panel = document.getElementById('analytics-consent');
        var settings = document.getElementById('analytics-settings');
        var accept = document.getElementById('analytics-accept');
        var reject = document.getElementById('analytics-reject');
        if (!panel || !settings || !accept || !reject) return;

        var choice = null;
        try { choice = localStorage.getItem(KEY); } catch (e) {}
        var loaded = false;
        function loadAnalytics() {
          if (loaded) return;
          loaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', GA_ID);
          var tag = document.createElement('script');
          tag.async = true;
          tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
          document.head.appendChild(tag);
        }
        function display() {
          panel.hidden = choice === 'accepted' || choice === 'rejected';
          settings.hidden = !panel.hidden;
        }
        function forgetAnalyticsCookies() {
          document.cookie.split(';').forEach(function (part) {
            var name = part.split('=')[0].trim();
            if (/^(_ga($|_)|_gid$|_gat($|_))/.test(name)) {
              document.cookie = name + '=; Max-Age=0; path=/; SameSite=Lax';
            }
          });
        }
        accept.addEventListener('click', function () {
          choice = 'accepted';
          try { localStorage.setItem(KEY, choice); } catch (e) {}
          display();
          loadAnalytics();
        });
        reject.addEventListener('click', function () {
          var wasLoaded = loaded;
          choice = 'rejected';
          try { localStorage.setItem(KEY, choice); } catch (e) {}
          display();
          forgetAnalyticsCookies();
          // If GA was loaded in this tab, reload to stop further collection.
          if (wasLoaded) window.location.reload();
        });
        settings.addEventListener('click', function () {
          panel.hidden = false;
          settings.hidden = true;
          accept.focus();
        });
        display();
        if (choice === 'accepted') loadAnalytics();
      })();
    </script>
  </body>
</html>
